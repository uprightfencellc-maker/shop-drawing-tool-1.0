---
interface Props { rating?: number; class?: string }
const { rating = 5, class: cls = '' } = Astro.props;
---
<span class={`inline-flex gap-0.5 ${cls}`} role="img" aria-label={`${rating} out of 5 stars`}>
  {Array.from({ length: 5 }, (_, i) => (
    <svg aria-hidden="true" viewBox="0 0 20 20" class="h-5 w-5" fill={i < rating ? 'currentColor' : 'none'} stroke="currentColor">
      <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z" />
    </svg>
  ))}
</span>
