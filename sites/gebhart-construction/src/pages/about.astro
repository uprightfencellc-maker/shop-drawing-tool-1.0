---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTABand from '../components/CTABand.astro';
import Todo from '../components/Todo.astro';
import { business } from '../lib/site';
---
<BaseLayout
  title="About Ryan Gebhart | Gebhart Construction, Huber Heights OH"
  description="Gebhart Construction is run by Ryan Gebhart in Huber Heights, OH. Customers know him for clear communication, daily updates and sticking to the quote."

  crumbs={[{ name: 'About', href: '/about/' }]}>
  <PageHeader title="About Gebhart Construction" lead={business.mission} crumbs={[{ name: 'About', href: '/about/' }]} />

  <section class="py-14 md:py-20">
    <div class="container-site grid gap-12 md:grid-cols-[1fr_2fr]">
      <div class="flex aspect-[4/5] items-center justify-center rounded-lg bg-surface-alt p-6 text-center">
        <Todo label="RYAN'S PHOTO" />
      </div>
      <div class="prose-site">
        <h2>Meet Ryan</h2>
        <p class="mt-4">Gebhart Construction is owned by {business.owner}.</p>
        <p><Todo label="RYAN'S BIO" /></p>
        <dl class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-lg bg-surface-alt p-4"><dt class="text-sm font-semibold text-muted">Years in business</dt><dd class="mt-1"><Todo label="YEARS IN BUSINESS" /></dd></div>
          <div class="rounded-lg bg-surface-alt p-4"><dt class="text-sm font-semibold text-muted">License &amp; insurance</dt><dd class="mt-1"><Todo label="LICENSE / INSURANCE" /></dd></div>
          <div class="rounded-lg bg-surface-alt p-4"><dt class="text-sm font-semibold text-muted">Estimates</dt><dd class="mt-1">Free</dd></div>
          <div class="rounded-lg bg-surface-alt p-4"><dt class="text-sm font-semibold text-muted">Payment</dt><dd class="mt-1">{business.payment}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="bg-surface-alt py-14 md:py-20" aria-labelledby="how-heading">
    <div class="container-site">
      <h2 id="how-heading">How Ryan works</h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {business.howWeWork.map((step, i) => (
          <li class="rounded-lg bg-white p-6 shadow-sm">
            <span class="font-heading text-3xl font-extrabold text-link" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-2">{step.title}</h3>
            <p class="mt-2 text-muted">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <CTABand />
</BaseLayout>
