---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import CTABand from '../../components/CTABand.astro';
import Todo from '../../components/Todo.astro';
import { business, services, reviewsForService, telHref, smsHref, type Service } from '../../lib/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
interface Props { service: Service }
const { service } = Astro.props;
const site = Astro.site!;
const url = new URL(`/services/${service.slug}/`, site).href;
const related = reviewsForService(service).slice(0, 3);
const others = services.filter((s) => s.slug !== service.slug);
const crumbs = [
  { name: 'Services', href: '/services/' },
  { name: service.name, href: `/services/${service.slug}/` },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.name,
    serviceType: service.name,
    description: service.short,
    url,
    provider: { '@id': new URL('/#business', site).href },
  }
];
---
<BaseLayout title={service.metaTitle} description={service.metaDescription} jsonLd={jsonLd} crumbs={crumbs}>
  <PageHeader title={`${service.name} in Huber Heights, OH`} lead={service.short} crumbs={crumbs} />

  <section class="py-14 md:py-20">
    <div class="container-site grid gap-12 lg:grid-cols-[2fr_1fr]">
      <div class="prose-site">
        <h2>What we handle</h2>
        <ul class="mt-4 space-y-2">
          {service.scope.map((item) => (
            <li class="flex gap-3">
              <svg aria-hidden="true" viewBox="0 0 20 20" class="mt-1 h-5 w-5 flex-none text-link" fill="currentColor"><path d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <h2 class="mt-12">How Ryan works</h2>
        <ol class="mt-4 space-y-4">
          {business.howWeWork.map((step, i) => (
            <li class="flex gap-4">
              <span class="font-heading text-2xl font-extrabold text-link" aria-hidden="true">{i + 1}</span>
              <div><h3>{step.title}</h3><p class="text-muted">{step.body}</p></div>
            </li>
          ))}
        </ol>

        <h2 class="mt-12">Where we work</h2>
        <p class="mt-3">Based in Huber Heights. Service area: <Todo label="SERVICE AREA" /></p>
      </div>

      <aside aria-labelledby="estimate-aside" class="h-fit rounded-lg bg-surface-alt p-6 lg:sticky lg:top-28">
        <h2 id="estimate-aside" class="text-xl">Free {service.name.toLowerCase()} estimate</h2>
        <p class="mt-2 text-muted">Tell us what you need. Photos help.</p>
        <div class="mt-5 flex flex-col gap-3">
          <a href={`/contact/?service=${service.slug}`} class="btn btn-primary">Request an estimate</a>
          <a href={telHref} class="btn btn-outline-dark">Call {business.phone.display}</a>
          <a href={smsHref} class="btn btn-outline-dark">Text us</a>
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="bg-surface-alt py-14 md:py-20" aria-labelledby="svc-reviews">
      <div class="container-site">
        <h2 id="svc-reviews">What {service.name.toLowerCase()} customers say</h2>
        <ul class="mt-8 grid gap-6 md:grid-cols-3">
          {related.map((r) => <li><ReviewCard review={r} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="py-14" aria-labelledby="other-services">
    <div class="container-site">
      <h2 id="other-services" class="text-xl">Other services</h2>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        {others.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
      </ul>
    </div>
  </section>

  <CTABand />
</BaseLayout>
