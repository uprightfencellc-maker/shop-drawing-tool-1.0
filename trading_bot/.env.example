# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high            # low | medium | high | xhigh | max
ENABLE_WEB_SEARCH=false       # let the agent search the web for news/catalysts

# --- Robinhood (unofficial API via robin_stocks) ---
RH_USERNAME=you@example.com
RH_PASSWORD=
# Optional: base32 secret from Robinhood's authenticator-app 2FA setup, for unattended logins
RH_TOTP_SECRET=

# --- Mode ---
# paper: real Robinhood market data, simulated fills in a local ledger (default)
# live:  real orders. Also requires running with --live.
TRADING_MODE=paper
PAPER_STARTING_CASH=10000

# --- Risk limits (enforced in code, the agent cannot override them) ---
MAX_ORDER_USD=500
MAX_POSITION_PCT=0.20         # max single position as fraction of equity
MAX_POSITIONS=8
MIN_CASH_RESERVE_PCT=0.10     # keep at least this fraction of equity in cash
DAILY_LOSS_LIMIT_PCT=0.03     # stop opening new positions after this drawdown today
MAX_TRADES_PER_DAY=10
LIMIT_PRICE_BAND_PCT=0.05     # limit prices must be within this band of the last price
# Comma-separated, e.g. AAPL,MSFT,NVDA,SPY. Empty = any US stock/ETF.
SYMBOL_ALLOWLIST=
SYMBOL_BLOCKLIST=

# --- Agent loop ---
MAX_AGENT_STEPS=30
STATE_DIR=state
