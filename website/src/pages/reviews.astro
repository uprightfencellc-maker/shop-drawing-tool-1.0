---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ReviewCard from '../components/ReviewCard.astro';
import CTABand from '../components/CTABand.astro';
import Stars from '../components/Stars.astro';
import Todo from '../components/Todo.astro';
import { business, reviews } from '../lib/site';
const g = business.ratings.google, a = business.ratings.angi;
---
<BaseLayout
  title="Customer Reviews | Gebhart Construction, Huber Heights OH"
  description={`Gebhart Construction is rated ${g.value.toFixed(1)} stars on Google (${g.count} reviews) and ${a.value.toFixed(1)} on Angi (${a.count} reviews). Read what customers say about working with Ryan Gebhart.`}

  crumbs={[{ name: 'Reviews', href: '/reviews/' }]}>
  <PageHeader title="Customer reviews" lead="What customers say about working with Ryan." crumbs={[{ name: 'Reviews', href: '/reviews/' }]} />

  <section class="py-14 md:py-20">
    <div class="container-site">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-lg bg-surface-alt p-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-muted">Google</p>
          <p class="mt-1 flex items-center gap-3"><span class="font-heading text-3xl font-extrabold text-brand">{g.value.toFixed(1)}</span><Stars rating={g.value} class="text-link" /></p>
          <p class="text-muted">{g.count} reviews</p>
        </div>
        <div class="rounded-lg bg-surface-alt p-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-muted">Angi</p>
          <p class="mt-1 flex items-center gap-3"><span class="font-heading text-3xl font-extrabold text-brand">{a.value.toFixed(1)}</span><Stars rating={a.value} class="text-link" /></p>
          <p class="text-muted">{a.count} reviews · <a href={a.url} rel="noopener">Read them on Angi</a></p>
        </div>
      </div>

      <h2 class="mt-14">Reviews from Angi</h2>
      <ul class="mt-6 grid gap-6 md:grid-cols-2">
        {reviews.map((r) => <li><ReviewCard review={r} /></li>)}
      </ul>

      <div class="mt-14 rounded-lg border border-black/10 bg-white p-6">
        <h2 class="text-xl">Worked with us?</h2>
        <p class="mt-2 text-muted">A Google review helps other homeowners find us.</p>
        <p class="mt-4">
          {g.reviewUrl
            ? <a href={g.reviewUrl} class="btn btn-primary" rel="noopener">Leave us a Google review</a>
            : <Todo label="GOOGLE REVIEW LINK" />}
        </p>
      </div>
    </div>
  </section>
  <CTABand />
</BaseLayout>
