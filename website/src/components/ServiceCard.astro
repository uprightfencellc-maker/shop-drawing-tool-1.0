---
import type { Service } from '../lib/site';
interface Props { service: Service; headingLevel?: 'h2' | 'h3'; showGroup?: boolean }
const { service, headingLevel = 'h3', showGroup = false } = Astro.props;
const H = headingLevel;
---
<article class="relative flex h-full flex-col rounded-lg border border-black/10 bg-white p-6 shadow-sm transition hover:shadow-md focus-within:shadow-md">
  {showGroup && <p class="text-sm font-semibold uppercase tracking-wide text-muted">{service.group}</p>}
  <H class="text-xl">
    <a href={`/services/${service.slug}/`} class="text-brand no-underline after:absolute after:inset-0 hover:underline">{service.name}</a>
  </H>
  <p class="mt-2 flex-1 text-muted">{service.short}</p>
  <span class="mt-4 font-semibold text-link" aria-hidden="true">Learn more →</span>
</article>
