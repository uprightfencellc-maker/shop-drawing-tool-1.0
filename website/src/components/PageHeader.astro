---
interface Props { title: string; lead?: string; crumbs?: { name: string; href: string }[] }
const { title, lead, crumbs = [] } = Astro.props;
---
<div class="on-brand py-12 md:py-16">
  <div class="container-site">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-4 text-sm">
        <ol class="flex flex-wrap gap-2 text-on-brand-muted">
          <li><a href="/" class="!text-on-brand-muted">Home</a></li>
          {crumbs.map((c, i) => (
            <li class="flex gap-2">
              <span aria-hidden="true">/</span>
              {i === crumbs.length - 1
                ? <span aria-current="page">{c.name}</span>
                : <a href={c.href} class="!text-on-brand-muted">{c.name}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <h1>{title}</h1>
    {lead && <p class="mt-3 max-w-2xl text-lg text-on-brand-muted">{lead}</p>}
  </div>
</div>
