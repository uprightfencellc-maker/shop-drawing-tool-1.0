---
import Stars from './Stars.astro';
import { formatMonth, type Review } from '../lib/site';
interface Props { review: Review }
const { review } = Astro.props;
---
<figure class="flex h-full flex-col rounded-lg border border-black/10 bg-white p-6 shadow-sm">
  <Stars rating={review.rating} class="text-link" />
  <blockquote class="mt-3 flex-1 text-ink">
    <p>“{review.text}”</p>
  </blockquote>
  <figcaption class="mt-4 text-sm text-muted">
    <span class="font-semibold text-ink">{review.author}</span> · {review.project} ·
    <time datetime={review.date}>{formatMonth(review.date)}</time> · via {review.source}
  </figcaption>
</figure>
